# Timonel - Docker Compose Template
# Copy this to docker-compose.yml to start fresh
# The actual docker-compose.yml is modified by scripts and git-ignored

# Compose project name: fixes the names of volumes and built images
# (timonel_mysql_data, timonel-<project>) whatever this folder is called
name: timonel

services:
  # =================================================================
  # TRAEFIK - Dynamic Reverse Proxy
  # =================================================================
  traefik:
    image: traefik:v3.6
    container_name: timonel_traefik
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--api.dashboard=true"
      - "--api.insecure=true"
    ports:
      - "80:80"
      - "127.0.0.1:8080:8080"   # dashboard (no auth): this Mac only
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - timonel
    restart: unless-stopped

  # =================================================================
  # MYSQL - Shared Database Server
  # =================================================================
  # Projects will create individual databases/users in this MySQL instance
  mysql:
    image: mysql:8.4
    container_name: timonel_mysql
    restart: unless-stopped
    ports:
      - "127.0.0.1:3306:3306"   # MySQL for local tools (TablePlus...): this Mac only
    volumes:
      - mysql_data:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: timonel
      TZ: "Europe/Zurich"
    networks:
      - timonel
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5

  # =================================================================
  # ADMINER - Database Management UI
  # =================================================================
  # Access at: http://timonel-adminer.localhost
  # Server: mysql | Username: root | Password: timonel
  adminer:
    image: adminer:6
    container_name: timonel_adminer
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.adminer.rule=Host(`timonel-adminer.localhost`)"
      - "traefik.http.services.adminer.loadbalancer.server.port=8080"
    environment:
      ADMINER_DEFAULT_SERVER: mysql
      TZ: "Europe/Zurich"
    networks:
      - timonel
    depends_on:
      mysql:
        condition: service_healthy

  # =================================================================
  # MAILPIT - Email Testing
  # =================================================================
  # Web UI: http://timonel-mailpit.localhost
  # SMTP: mailpit:1025 (use from WordPress/apps)
  mailpit:
    image: axllent/mailpit:v1.32
    container_name: timonel_mailpit
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mailpit.rule=Host(`timonel-mailpit.localhost`)"
      - "traefik.http.services.mailpit.loadbalancer.server.port=8025"
    ports:
      - "127.0.0.1:1025:1025"   # SMTP for apps running outside Docker: this Mac only
    environment:
      TZ: "Europe/Zurich"
    networks:
      - timonel

  # =================================================================
  # YOUR PROJECTS WILL BE ADDED BELOW BY SCRIPTS
  # =================================================================
  # Example Next.js project structure:
  #
  # project-name:
  #   build:
  #     context: ./apps/project-name
  #     dockerfile: Dockerfile
  #   container_name: timonel_project_name
  #   labels:
  #     - "traefik.enable=true"
  #     - "traefik.http.routers.project-name.rule=Host(`project-name.localhost`)"
  #     - "traefik.http.services.project-name.loadbalancer.server.port=3000"
  #   volumes:
  #     - ./apps/project-name:/app
  #     - /app/node_modules
  #     - /app/.next
  #   environment:
  #     - NODE_ENV=development
  #   networks:
  #     - timonel
  #   restart: "no" | change to unless-stopped if you want it to persist

volumes:
  mysql_data:

networks:
  timonel:
    name: timonel
    driver: bridge
