#!/bin/bash

# Timonel - run many local projects (Next.js, Vite, Parcel, WordPress,
# Laravel) side by side in Docker, behind Traefik, with shared MySQL,
# Adminer and Mailpit. This file only dispatches: each command is a script
# in scripts/.

# Get the directory where this script really lives (it's usually run
# through the /usr/local/bin/timonel symlink)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Change to that directory so all paths work
cd "$SCRIPT_DIR"

# Restore the scripts' execute permission if it got lost (e.g. the repo was
# downloaded as a zip instead of cloned)
if [ ! -x scripts/add-to-compose.sh ]; then
    chmod +x scripts/*.sh 2>/dev/null || true
fi

# ============================================
# Command log (logs/timonel.log, git-ignored; read with `timonel history`)
# ============================================
# The first call re-runs this same script with TIMONEL_LOGGED=1 and records:
#   === <date> <time>  timonel <args>      (start)
#   <the command's output, colours removed> (not for dev/logs)
#   --- exit <code> in <seconds>s           (end; "interrupted" on Ctrl+C)
# `dev` (an interactive shell) and `logs` (follows forever) only get the
# start and end lines, since copying their output would get in the way.
LOG_FILE="$SCRIPT_DIR/logs/timonel.log"
LOG_MAX_LINES=5000

log_line() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null && echo "$1" >> "$LOG_FILE" 2>/dev/null || true
}

# Keep only the last LOG_MAX_LINES lines
trim_log() {
    local lines tmp
    [ -f "$LOG_FILE" ] || return 0
    lines=$(wc -l < "$LOG_FILE")
    if [ "$lines" -gt "$LOG_MAX_LINES" ]; then
        tmp=$(mktemp)
        tail -n "$LOG_MAX_LINES" "$LOG_FILE" > "$tmp" && cat "$tmp" > "$LOG_FILE"
        rm -f "$tmp"
    fi
}

if [ -z "${TIMONEL_LOGGED:-}" ] && [ $# -gt 0 ] && [ "$1" != "help" ] && [ "$1" != "history" ]; then
    LOG_STARTED=$(date +%s)
    INTERRUPTED=false
    trap 'INTERRUPTED=true' INT
    log_line "=== $(date '+%Y-%m-%d %H:%M:%S')  timonel $*"

    case "$1" in
        dev|logs)
            # Interactive: keep the terminal, record start and end only.
            # Ctrl+C is normal use here (stopping `npm run dev`, leaving
            # `logs -f`), so it isn't recorded as an interruption.
            TIMONEL_LOGGED=1 "$SCRIPT_DIR/timonel" "$@"
            RC=$?
            INTERRUPTED=false
            ;;
        *)
            # Show the output as usual, and keep a copy for the log
            OUTPUT=$(mktemp)
            TIMONEL_LOGGED=1 "$SCRIPT_DIR/timonel" "$@" 2>&1 | tee "$OUTPUT"
            RC=${PIPESTATUS[0]}
            # Remove colour codes and carriage returns before saving
            perl -pe 's/\e\[[0-9;?]*[A-Za-z]//g; s/\r//g; $_ = "" if /^(╔|║|╚)/; $s ||= /\S/; $_ = "" unless $s' "$OUTPUT" >> "$LOG_FILE" 2>/dev/null || true
            rm -f "$OUTPUT"
            # Output ending without a newline (e.g. a prompt) mustn't swallow the end line
            if [ -s "$LOG_FILE" ] && [ -n "$(tail -c 1 "$LOG_FILE")" ]; then
                echo >> "$LOG_FILE"
            fi
            ;;
    esac

    if [ "$INTERRUPTED" = true ]; then
        log_line "--- interrupted (exit $RC) after $(( $(date +%s) - LOG_STARTED ))s"
    else
        log_line "--- exit $RC in $(( $(date +%s) - LOG_STARTED ))s"
    fi
    trim_log
    exit "$RC"
fi

# Project-name helpers (validation, reserved names) and compose lookups
source scripts/lib/project.sh
source scripts/lib/compose.sh

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
show_header() {
    echo -e "${BLUE}"
    echo "╔════════════════════════════════════════╗"
    echo "║          TIMONEL                       ║"
    echo "║   Docker Multi-Project Manager         ║"
    echo "╚════════════════════════════════════════╝"
    echo -e "${NC}"
}

show_menu() {
    echo ""
    echo "Shared services:"
    echo "  up                         Start Traefik, MySQL, Adminer and Mailpit"
    echo "  down                       Stop everything, projects included"
    echo ""
    echo "Projects:"
    echo "  new <type> <name>          Create a project: nextjs, vite, parcel, wp, laravel"
    echo "                             [--with-db]  (Node types) connect it to MySQL"
    echo "                             [--kit react|vue|svelte|livewire]  (laravel) starter kit"
    echo "  add <name> [--with-db]     Dockerize an existing project in apps/<name>"
    echo "  dev <name>                 Open a dev shell in a project"
    echo "  start | stop <name>        Start or stop a project"
    echo "  restart <name>             Restart and reinstall its dependencies"
    echo "  list                       List projects with type and status"
    echo "  logs [name]                Follow logs (one project, or everything)"
    echo "  open <name>                Open a project in VS Code"
    echo "  remove <name>              Remove a project (asks first)"
    echo ""
    echo "Other:"
    echo "  hosts                      Write the *.localhost names into /etc/hosts (sudo)"
    echo "  history [--errors]         Recent commands (--errors: failed ones, with output)"
    echo "  help                       Show this menu"
    echo ""
}

# Main script
show_header

# Check if command provided
if [ $# -eq 0 ]; then
    show_menu
    exit 0
fi

COMMAND=$1

# Validate the project name before any script uses it in paths
# (rm -rf apps/<name>), sed replacements or SQL
case $COMMAND in
    new) NAME_ARG=${3-} ;;
    add|remove|open|start|stop|restart|logs|dev) NAME_ARG=${2-} ;;
    *) NAME_ARG="" ;;
esac

if [ -n "$NAME_ARG" ]; then
    if ! is_valid_project_name "$NAME_ARG"; then
        echo -e "${RED}❌ Invalid project name: '$NAME_ARG'${NC}"
        echo "   Use only letters, digits, '-' and '_', starting with a letter or digit."
        exit 1
    fi
    # Creating, adding or removing a core service name would clobber shared services
    if { [ "$COMMAND" = "new" ] || [ "$COMMAND" = "add" ] || [ "$COMMAND" = "remove" ]; } && is_reserved_project_name "$NAME_ARG"; then
        echo -e "${RED}❌ '$NAME_ARG' is reserved by Timonel (${TIMONEL_RESERVED_NAMES// /, })${NC}"
        exit 1
    fi
fi

# Reject unexpected extra arguments instead of silently ignoring them
# (`new` and `add` check their own optional --with-db flag)
case $COMMAND in
    remove|open|start|stop|restart|dev|logs|history) MAX_ARGS=2 ;;
    up|down|list|hosts|help)                 MAX_ARGS=1 ;;
    *)                                       MAX_ARGS="" ;;
esac
if [ -n "$MAX_ARGS" ] && [ $# -gt "$MAX_ARGS" ]; then
    echo -e "${RED}❌ Unexpected argument(s) for '$COMMAND': ${*:$((MAX_ARGS + 1))}${NC}"
    show_menu
    exit 1
fi

case $COMMAND in
    new)
        NEW_USAGE="timonel new <type> <name> [--with-db] | timonel new laravel <name> [--kit react|vue|svelte|livewire]"
        if [ $# -lt 3 ]; then
            echo -e "${RED}Usage: $NEW_USAGE${NC}"
            echo "  Types: nextjs, vite, parcel, wp, laravel"
            exit 1
        fi

        PROJECT_TYPE=$2
        PROJECT_NAME=$3
        WITH_DB=""
        KIT=""

        # Optional flags; anything else is a typo, not ignored
        shift 3
        while [ $# -gt 0 ]; do
            case "$1" in
                --with-db) WITH_DB="--with-db" ;;
                --kit)
                    KIT=${2-}
                    case "$KIT" in
                        react|vue|svelte|livewire) shift ;;
                        *)
                            echo -e "${RED}❌ --kit needs one of: react, vue, svelte, livewire${NC}"
                            exit 1
                            ;;
                    esac
                    ;;
                *)
                    echo -e "${RED}Unknown option: $1${NC}"
                    echo "  Usage: $NEW_USAGE"
                    exit 1
                    ;;
            esac
            shift
        done
        if [ -n "$KIT" ] && [ "$PROJECT_TYPE" != "laravel" ]; then
            echo -e "${RED}❌ --kit is only for Laravel projects${NC}"
            exit 1
        fi

        # `new` only creates fresh projects; existing ones go through `add`
        if [ -d "apps/$PROJECT_NAME" ]; then
            echo -e "${RED}❌ apps/$PROJECT_NAME already exists${NC}"
            echo "   To dockerize an existing project, use: timonel add $PROJECT_NAME"
            exit 1
        fi
        if project_service_exists "$(to_safe_name "$PROJECT_NAME")"; then
            echo -e "${RED}❌ A project called '$(to_safe_name "$PROJECT_NAME")' is already in docker-compose.yml${NC}"
            echo "   Pick another name, or remove it first: timonel remove $(to_safe_name "$PROJECT_NAME")"
            exit 1
        fi

        case $PROJECT_TYPE in
            nextjs)
                ./scripts/new-nextjs.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            wp)
                if [ -n "$WITH_DB" ]; then
                    echo -e "${YELLOW}ℹ️  WordPress always gets a database; --with-db isn't needed${NC}"
                fi
                ./scripts/new-wordpress.sh "$PROJECT_NAME"
                ;;
            vite)
                ./scripts/new-vite-react.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            parcel)
                ./scripts/new-parcel.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            laravel)
                if [ -n "$WITH_DB" ]; then
                    echo -e "${YELLOW}ℹ️  Laravel always gets a database; --with-db isn't needed${NC}"
                fi
                ./scripts/new-laravel.sh "$PROJECT_NAME" "$KIT"
                ;;
            *)
                echo -e "${RED}Unknown project type: $PROJECT_TYPE${NC}"
                echo "Available types: nextjs, vite, parcel, wp, laravel"
                exit 1
                ;;
        esac
        ;;
    add)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel add <name> [--with-db]${NC}"
            echo "  Dockerizes an existing project in apps/<name>"
            exit 1
        fi
        if [ $# -gt 3 ] || { [ -n "${3-}" ] && [ "$3" != "--with-db" ]; }; then
            echo -e "${RED}Unknown option: ${*:3}${NC}"
            echo "  Usage: timonel add <name> [--with-db]"
            exit 1
        fi

        ./scripts/add-project.sh "$2" "${3-}"
        ;;
    remove)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel remove <name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/remove-project.sh "$PROJECT_NAME"
        ;;
    open)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel open <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/open-project.sh "$PROJECT_NAME"
        ;;
    dev)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel dev <project-name>${NC}"
            exit 1
        fi

        PROJECT_NAME=$2
        ./scripts/dev-project.sh "$PROJECT_NAME"
        ;;
    hosts)
        ./scripts/sync-hosts.sh
        ;;
    history)
        ./scripts/show-history.sh "${2-}"
        ;;
    list)
        ./scripts/list-projects.sh
        ;;
    start)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel start <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/start-project.sh "$PROJECT_NAME"
        ;;
    
    stop)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel stop <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/stop-project.sh "$PROJECT_NAME"
        ;;
    restart)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: timonel restart <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/restart-project.sh "$PROJECT_NAME"
        ;;
    up)
        docker compose up -d
        ;;
    down)
        # --profile projects: also stop project containers. Recent Compose
        # versions do this anyway; older ones skip services in a profile.
        docker compose --profile projects down
        ;;
    logs)
        # --profile projects: include project containers in the combined
        # logs on every Compose version (see `down`)
        if [ -n "$2" ]; then
            docker compose --profile projects logs -f "$(to_safe_name "$2")"
        else
            docker compose --profile projects logs -f
        fi
        ;;
    help)
        show_menu
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        show_menu
        exit 1
        ;;
esac