#!/bin/bash

# Dockerator - Multi-project Docker orchestration
# Similar to devner but for learning Docker concepts

# Auto-fix script permissions if needed
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$SCRIPT_DIR/scripts/new-wordpress.sh" ]; then
    chmod +x "$SCRIPT_DIR"/scripts/*.sh 2>/dev/null || true
fi

# Get the directory where this script is located
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Change to that directory so all paths work
cd "$SCRIPT_DIR"

# Project-name helpers (validation, reserved names) and compose lookups
source scripts/lib/project.sh
source scripts/lib/compose.sh

# DEBUG - temporary
# echo "DEBUG: Script dir: $SCRIPT_DIR"
# echo "DEBUG: Current dir: $(pwd)"
# echo "DEBUG: Scripts directory contents:"
# ls -la scripts/ 2>&1 || echo "scripts/ not found!"
# echo ""


set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
show_header() {
    echo -e "${BLUE}"
    echo "╔════════════════════════════════════════╗"
    echo "║          DOCKERATOR                    ║"
    echo "║   Docker Multi-Project Manager         ║"
    echo "╚════════════════════════════════════════╝"
    echo -e "${NC}"
}

show_menu() {
    echo ""
    echo "Available commands:"
    echo "  up                 - Start all containers"
    echo "  down               - Stop all containers"
    echo "  new <type> <name>  - Create new project (nextjs, vite, parcel, wp)"
    echo "  add <name>         - Dockerize an existing project in apps/<name>"
    echo "  open <name>        - Open a project in VS Code"
    echo "  remove <name>      - Remove a project"
    echo "  start <name>       - Start a specific project"
    echo "  stop <name>        - Stop a specific project"
    echo "  restart <name>     - Restart with a full dependency reinstall"
    echo "  dev <name>         - Open a dev shell in a project (WordPress/Laravel: with Vite's port 5173)"
    echo "  list               - List all projects"
    echo "  logs <name>        - View logs for a project"
    echo "  hosts              - Sync /etc/hosts with all *.localhost domains"
    echo "  help               - Show this menu"
    echo ""
}

# Main script
show_header

# Check if command provided
if [ $# -eq 0 ]; then
    show_menu
    exit 0
fi

COMMAND=$1

# Validate the project name before any script uses it in paths
# (rm -rf apps/<name>), sed replacements or SQL
case $COMMAND in
    new) NAME_ARG=${3-} ;;
    add|remove|open|start|stop|restart|logs|dev) NAME_ARG=${2-} ;;
    *) NAME_ARG="" ;;
esac

if [ -n "$NAME_ARG" ]; then
    if ! is_valid_project_name "$NAME_ARG"; then
        echo -e "${RED}❌ Invalid project name: '$NAME_ARG'${NC}"
        echo "   Use only letters, digits, '-' and '_', starting with a letter or digit."
        exit 1
    fi
    # Creating, adding or removing a core service name would clobber shared services
    if { [ "$COMMAND" = "new" ] || [ "$COMMAND" = "add" ] || [ "$COMMAND" = "remove" ]; } && is_reserved_project_name "$NAME_ARG"; then
        echo -e "${RED}❌ '$NAME_ARG' is reserved by Dockerator (${DOCKERATOR_RESERVED_NAMES// /, })${NC}"
        exit 1
    fi
fi

# Reject unexpected extra arguments instead of silently ignoring them
# (`new` and `add` check their own optional --with-db flag)
case $COMMAND in
    remove|open|start|stop|restart|dev|logs) MAX_ARGS=2 ;;
    up|down|list|hosts|help)                 MAX_ARGS=1 ;;
    *)                                       MAX_ARGS="" ;;
esac
if [ -n "$MAX_ARGS" ] && [ $# -gt "$MAX_ARGS" ]; then
    echo -e "${RED}❌ Unexpected argument(s) for '$COMMAND': ${*:$((MAX_ARGS + 1))}${NC}"
    show_menu
    exit 1
fi

case $COMMAND in
    new)
        if [ $# -lt 3 ]; then
            echo -e "${RED}Usage: dockerator new <type> <name> [--with-db]${NC}"
            echo "  Types: nextjs, vite, parcel, wp"
            exit 1
        fi

        PROJECT_TYPE=$2
        PROJECT_NAME=$3
        WITH_DB=${4-}

        # Only one optional flag exists; anything else is a typo, not ignored
        if [ $# -gt 4 ] || { [ -n "$WITH_DB" ] && [ "$WITH_DB" != "--with-db" ]; }; then
            echo -e "${RED}Unknown option: ${*:4}${NC}"
            echo "  Usage: dockerator new <type> <name> [--with-db]"
            exit 1
        fi

        # `new` only creates fresh projects; existing ones go through `add`
        if [ -d "apps/$PROJECT_NAME" ]; then
            echo -e "${RED}❌ apps/$PROJECT_NAME already exists${NC}"
            echo "   To dockerize an existing project, use: dockerator add $PROJECT_NAME"
            exit 1
        fi
        if project_service_exists "$(to_safe_name "$PROJECT_NAME")"; then
            echo -e "${RED}❌ A project called '$(to_safe_name "$PROJECT_NAME")' is already in docker-compose.yml${NC}"
            echo "   Pick another name, or remove it first: dockerator remove $(to_safe_name "$PROJECT_NAME")"
            exit 1
        fi

        case $PROJECT_TYPE in
            nextjs)
                ./scripts/new-nextjs.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            wp)
                if [ -n "$WITH_DB" ]; then
                    echo -e "${YELLOW}ℹ️  WordPress always gets a database; --with-db isn't needed${NC}"
                fi
                ./scripts/new-wordpress.sh "$PROJECT_NAME"
                ;;
            vite)
                ./scripts/new-vite-react.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            parcel)
                ./scripts/new-parcel.sh "$PROJECT_NAME" "$WITH_DB"
                ;;
            *)
                echo -e "${RED}Unknown project type: $PROJECT_TYPE${NC}"
                echo "Available types: nextjs, vite, parcel, wp"
                exit 1
                ;;
        esac
        ;;
    add)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator add <name> [--with-db]${NC}"
            echo "  Dockerizes an existing project in apps/<name>"
            exit 1
        fi
        if [ $# -gt 3 ] || { [ -n "${3-}" ] && [ "$3" != "--with-db" ]; }; then
            echo -e "${RED}Unknown option: ${*:3}${NC}"
            echo "  Usage: dockerator add <name> [--with-db]"
            exit 1
        fi

        ./scripts/add-project.sh "$2" "${3-}"
        ;;
    remove)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator remove <name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/remove-project.sh "$PROJECT_NAME"
        ;;
    open)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator open <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/open-project.sh "$PROJECT_NAME"
        ;;
    dev)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator dev <project-name>${NC}"
            exit 1
        fi

        PROJECT_NAME=$2
        ./scripts/dev-project.sh "$PROJECT_NAME"
        ;;
    hosts)
        echo "DEBUG: Running sync-hosts.sh"
        echo "DEBUG: Current dir: $(pwd)"
        echo "DEBUG: Script exists: $(ls -la scripts/sync-hosts.sh 2>&1)"
        ./scripts/sync-hosts.sh
        ;;
    list)
        ./scripts/list-projects.sh
        ;;
    start)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator start <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/start-project.sh "$PROJECT_NAME"
        ;;
    
    stop)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator stop <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/stop-project.sh "$PROJECT_NAME"
        ;;
    restart)
        if [ -z "$2" ]; then
            echo -e "${RED}Usage: dockerator restart <project-name>${NC}"
            exit 1
        fi
        
        PROJECT_NAME=$2
        ./scripts/restart-project.sh "$PROJECT_NAME"
        ;;
    up)
        docker-compose up -d
        ;;
    down)
        # --profile projects: also stop project containers. Recent Compose
        # versions do this anyway; older ones skip services in a profile.
        docker-compose --profile projects down
        ;;
    logs)
        # --profile projects: include project containers in the combined
        # logs on every Compose version (see `down`)
        if [ -n "$2" ]; then
            docker-compose --profile projects logs -f "$(to_safe_name "$2")"
        else
            docker-compose --profile projects logs -f
        fi
        ;;
    help)
        show_menu
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        show_menu
        exit 1
        ;;
esac